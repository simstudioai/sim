{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run dev:cache:cap && next dev --port 3001",
    "dev:cache:cap": "bun run ../../scripts/prune-turbopack-cache.ts",
    "dev:clean": "rm -rf .next/dev/cache",
    "build": "fumadocs-mdx && NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "type-check": "fumadocs-mdx && tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@sim/db": "workspace:*",
    "@sim/emcn": "workspace:*",
    "@sim/workflow-renderer": "workspace:*",
    "@xyflow/react": "12.11.3",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.2",
    "fumadocs-core": "16.8.5",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-openapi": "10.8.1",
    "fumadocs-ui": "16.8.5",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-breaks": "^4.0.0",
    "shiki": "4.3.1",
    "framer-motion": "^12.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.0.12",
    "@types/node": "24.2.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.0.4",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
