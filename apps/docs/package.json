{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run dev:cache:cap && bun run llms-full:generate && bunx concurrently --kill-others --names Next,LLMs \"next dev --port 3001\" \"bun scripts/watch-llms-full.ts\"",
    "dev:cache:cap": "bun run ../../scripts/prune-turbopack-cache.ts",
    "dev:clean": "rm -rf .next/dev/cache",
    "build": "bun scripts/fetch-git-history.ts && bun run llms-full:generate && NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "test:negotiation:e2e": "bun scripts/test-negotiation-e2e.ts",
    "test:headers:e2e": "bun scripts/test-header-merge-e2e.ts",
    "type-check": "fumadocs-mdx && tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "llms-full:generate": "fumadocs-mdx && bun scripts/generate-llms-full.ts",
    "test:navigation:e2e": "bun scripts/test-navigation-e2e.ts"
  },
  "dependencies": {
    "@sim/db": "workspace:*",
    "@sim/deployment-config": "workspace:*",
    "@sim/emcn": "workspace:*",
    "@sim/logger": "workspace:*",
    "@sim/utils": "workspace:*",
    "@sim/workflow-renderer": "workspace:*",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.4",
    "fumadocs-core": "16.8.5",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-openapi": "10.8.1",
    "fumadocs-ui": "16.8.5",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "streamdown": "2.5.0",
    "framer-motion": "^12.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sim/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "gray-matter": "4.0.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
