{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run content:generate && bunx concurrently --kill-others --names Next,Content \"next dev --port 3001\" \"bun scripts/compile-content.ts --watch\"",
    "dev:cache:cap": "bun run ../../scripts/prune-turbopack-cache.ts",
    "dev:clean": "rm -rf .next/dev/cache",
    "build": "bun scripts/fetch-git-history.ts && bun run content:generate && NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "next start",
    "test": "vitest run",
    "test:negotiation:e2e": "bun scripts/test-negotiation-e2e.ts",
    "test:headers:e2e": "bun scripts/test-header-merge-e2e.ts",
    "type-check": "bun run content:generate && next typegen && tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "llms-full:generate": "bun run content:generate",
    "test:navigation:e2e": "bun scripts/test-navigation-e2e.ts",
    "content:generate": "bun scripts/compile-content.ts",
    "test:interfaces:e2e": "bun scripts/test-docs-interfaces-e2e.ts",
    "search:plan": "bun scripts/index-search.ts --plan",
    "search:check": "bun scripts/index-search.ts --check",
    "content:verify-migration": "bun scripts/compile-content.ts --verify-migration",
    "test:corpus:e2e": "bun scripts/test-corpus-e2e.ts",
    "test:search:postgres:e2e": "bun --no-env-file --conditions=react-server scripts/test-search-postgres-e2e.ts"
  },
  "dependencies": {
    "@sim/deployment-config": "workspace:*",
    "@sim/emcn": "workspace:*",
    "@sim/logger": "workspace:*",
    "@sim/utils": "workspace:*",
    "@sim/workflow-renderer": "workspace:*",
    "@xyflow/react": "12.12.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "framer-motion": "^12.5.0",
    "zod": "4.3.6",
    "@mdx-js/mdx": "3.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-query": "^5.90.21",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "@shikijs/rehype": "4.5.0",
    "server-only": "0.0.1",
    "postgres": "3.4.9",
    "remark-rehype": "11.1.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdxjs-esm": "2.0.1",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sim/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "gray-matter": "4.0.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.13",
    "htmlparser2": "10.1.0",
    "@types/hast": "3.0.5"
  }
}
