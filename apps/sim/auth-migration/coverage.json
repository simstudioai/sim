  "native": [
    {
      "surface": "offline",
      "states": ["offline", "DNS", "TLS", "timeout", "unreachable", "cloud status", "self-hosted"],
      "actions": ["retry", "check status on Sim Cloud", "change server", "support"]
    },
    {
      "surface": "server",
      "states": ["current server", "invalid URL", "pending", "unchanged server", "failure"],
      "actions": ["connect", "cancel", "Escape/window close"]
    }
  ],
  "externalBoundaries": [
    "Google, Microsoft and GitHub provider pages",
    "SSO identity providers",
    "CAPTCHA and password-manager UI",
    "OS window chrome",
    "resource authorization and account session cookies"
  ],
  "validationNotes": "State inventory records the retained surface contract; it is not a claim that every external provider or organization policy was exercised locally."
}
