{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/sim/{app,components,blocks,lib,ee,content}/**",
        "$TURBO_ROOT$/packages/emcn/src/**",
        "$TURBO_ROOT$/packages/workflow-renderer/src/**",
