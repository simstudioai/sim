{
  "name": "@sim/workflow-sdk",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/core.d.ts",
      "default": "./src/runtime.ts"
    },
    "./workspace": {
      "types": "./src/workspace/index.d.ts",
      "default": "./src/workspace/runtime.ts"
    },
    "./codegen": {
      "types": "./src/codegen/index.ts",
      "default": "./src/codegen/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sim/utils": "workspace:*",
    "@sim/workflow-code": "workspace:*",
    "@sim/workflow-types": "workspace:*"
  },
  "devDependencies": {
    "@sim/testing": "workspace:*",
    "@sim/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "@xyflow/react": "12.12.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
