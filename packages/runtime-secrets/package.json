{
  "name": "@sim/runtime-secrets",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./trigger-env": {
      "types": "./src/trigger-env.ts",
      "default": "./src/trigger-env.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1162.0",
    "@sim/logger": "workspace:*",
    "@sim/security": "workspace:*",
    "@sim/utils": "workspace:*",
    "@smithy/fetch-http-handler": "5.8.0",
    "@smithy/node-http-handler": "4.14.1"
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
