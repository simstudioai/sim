{
  "name": "@sim/testing",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "./src/setup/*"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./factories": {
      "types": "./src/factories/index.ts",
      "default": "./src/factories/index.ts"
    },
    "./builders": {
      "types": "./src/builders/index.ts",
      "default": "./src/builders/index.ts"
    },
    "./mocks": {
      "types": "./src/mocks/index.ts",
      "default": "./src/mocks/index.ts"
    },
    "./mocks/executor": {
      "types": "./src/mocks/executor.mock.ts",
      "default": "./src/mocks/executor.mock.ts"
    },
    "./assertions": {
      "types": "./src/assertions/index.ts",
      "default": "./src/assertions/index.ts"
    },
    "./setup": {
      "types": "./src/setup/vitest.setup.ts",
      "default": "./src/setup/vitest.setup.ts"
    },
    "./environment": {
      "types": "./src/environment/index.ts",
      "default": "./src/environment/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "peerDependencies": {
    "next": ">=15 <17",
    "stripe": ">=18 <19",
    "vitest": "^3.0.0 || >=4.1.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "next": "16.3.1",
    "stripe": "18.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@sim/utils": "workspace:*"
  }
}
