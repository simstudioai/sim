{
  "name": "@sim/testing",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "./src/mocks/executor.mock.ts"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.1",
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./factories": {
      "types": "./src/factories/index.ts",
      "default": "./src/factories/index.ts"
    },
    "./factories/*": {
      "types": "./src/factories/*.ts",
      "default": "./src/factories/*.ts"
    },
    "./builders": {
      "types": "./src/builders/index.ts",
      "default": "./src/builders/index.ts"
    },
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "default": "./src/helpers/index.ts"
    },
    "./helpers/*": {
      "types": "./src/helpers/*.ts",
      "default": "./src/helpers/*.ts"
    },
    "./mocks": {
      "types": "./src/mocks/index.ts",
      "default": "./src/mocks/index.ts"
    },
    "./mocks/executor": {
      "types": "./src/mocks/executor.mock.ts",
      "default": "./src/mocks/executor.mock.ts"
    },
    "./mocks/*": {
      "types": "./src/mocks/*.ts",
      "default": "./src/mocks/*.ts"
    },
    "./environment": {
      "types": "./src/environment/index.ts",
      "default": "./src/environment/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "peerDependencies": {
    "next": ">=15 <17",
    "stripe": ">=18 <19",
    "vitest": "^5.0.1"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "next": "16.3.4",
    "stripe": "18.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@sim/auth": "workspace:*",
    "@sim/utils": "workspace:*"
  }
}
