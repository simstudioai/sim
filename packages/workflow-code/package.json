{
  "name": "@sim/workflow-code",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
