    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@noble/hashes": "2.2.0",
    "@sim/utils": "workspace:*",
    "@sim/workflow-types": "workspace:*"
  },
  "devDependencies": {
    "@babel/types": "7.29.8",
    "@sim/tsconfig": "workspace:*",
    "@xyflow/react": "12.12.1",
    "fast-check": "3.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
