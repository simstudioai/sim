{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "envMode": "loose",
  // CI planning (`.github/scripts/ci-plan.gql`) needs `affectedTasks` to match changed files
  // against each task's `inputs`; without a task-level flag Turborepo reports every task of an
  // affected package. `filterUsingTasks` opts into that, and CI's `--filter` calls only name
  // packages, so it selects the same tasks. `affectedUsingTaskInputs` would also do it, but it
  // makes `turbo prune` keep packages reached only through `pkg#task` dependencies, which pulls
  // desktop, docs, and realtime into the app image.
  "futureFlags": { "filterUsingTasks": true },
  // Local cache eviction is opt-in until Turborepo 3.0, so without these the
  // filesystem cache grows forever. In CI each cache dir is a Blacksmith sticky
  // disk that is mounted many times a day, so it never goes idle long enough for
  // Blacksmith's own 7-day inactivity purge to fire, and one cache-missing app
  // build writes a ~400 MB artifact: the build cache reached 206 GB in 43 days.
  //
  // Size is the real bound and age is hygiene. A hit only happens when a task's
  // input hash is unchanged — a re-run, or a commit touching only unrelated
  // workspaces — which recurs within hours, so nothing older than a day or two
  // can ever be read again. Measured hit rate on the app build is ~17%, worth
  // ~7 minutes each, so the cache earns its keep; it just needs a ceiling.
  // 40 GB is ~100 app-sized artifacts against ~4.8 GB/day of real accumulation.
  //
  // Neither key participates in the task hash, so changing them does not
  // invalidate the cache.
  "cacheMaxAge": "7d",
  "cacheMaxSize": "40GB",
  // Bun applies `patches/*` to installed dependencies, but `bun.lock` records only each patch's
  // path, so editing a patch leaves every task hash unchanged and replays a build of the
  // unpatched dependency. Hash the patch contents into every task.
  "globalDependencies": ["patches/**"],
  "tasks": {
    "ci:runtime": {
      "dependsOn": ["^ci:runtime"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.integration.ts",
        "!**/AGENTS.md",
        "!**/CLAUDE.md",
        "!vitest.*",
        "!test-results/**",
        "!e2e/**"
      ],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.integration.ts",
        "!**/AGENTS.md",
        "!**/CLAUDE.md"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.integration.ts",
        "!**/AGENTS.md",
        "!**/CLAUDE.md",
        "$TURBO_ROOT$/vitest.shared.ts"
      ],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"],
      "dependsOn": ["transit"],
      "outputs": []
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"],
      "outputs": []
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"],
      "outputs": []
    },
    "lint:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"],
      "dependsOn": ["transit"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
